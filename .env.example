# ==========================================
# Eunomia Environment Variables (Template)
# Copy this file to .env before running Docker
# ==========================================

# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_strong_postgres_password
POSTGRES_DB=linear_db
POSTGRES_PORT=5432

# Backend & Security Configuration
PORT=4000
JWT_SECRET=generate_a_random_32_character_secret_key_here
BASE_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3002
UPLOAD_DEST=./uploads
NODE_ENV=production

# Frontend Configuration
FRONTEND_PORT=3002
NEXT_PUBLIC_API_URL=http://localhost:4000

# SMTP / Email Notifications (e.g. Gmail App Password or Resend)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_character_app_password
SMTP_SECURE=true
EMAIL_FROM="Eunomia" <notifications@yourdomain.com>
